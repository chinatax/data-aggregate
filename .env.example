# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，请勿提交到公开仓库。
# docker compose 会自动读取同目录的 .env；backend 容器通过 environment 透传给 Spring。

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# QQ 邮箱 SMTP
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT 签名密钥（至少 256 位）
JWT_SECRET=

# 微信开放平台
WECHAT_APP_SECRET=

# NewsData.io 新闻聚合
NEWSDATA_API_KEY=
NEWSDATA_TAX_API_KEY=
